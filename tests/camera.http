@deviceId = 6fdce032-90da-4a27-938b-9b5c367121f4
@deviceToken = replace-with-a-current-device-token
@userToken = replace-with-a-current-user-jwt
@otherUserToken = replace-with-another-users-jwt
@publicationId = replace-with-a-publication-id-from-the-201-response
@viewerId = replace-with-a-viewer-id-from-the-201-response

### Ask the cane to start streaming (existing command API, not WebRTC)
POST http://localhost:8080/api/v1/devices/{{deviceId}}/commands
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "type": "START_CAMERA_STREAM",
  "payload": {}
}

### Publish the cane's camera (WHIP): non-trickle offer, all candidates inline
POST http://localhost:8080/api/v1/firmware/devices/{{deviceId}}/camera/publications
Authorization: Bearer {{deviceToken}}
Content-Type: application/sdp
Accept: application/sdp

v=0
o=- 1 1 IN IP4 127.0.0.1
s=-
t=0 0
a=group:BUNDLE 0
m=video 9 UDP/TLS/RTP/SAVPF 96
c=IN IP4 0.0.0.0
a=rtcp-mux
a=ice-ufrag:canefrag
a=ice-pwd:canepanioncanepwdexample01
a=fingerprint:sha-256 00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF
a=setup:actpass
a=mid:0
a=sendonly
a=rtpmap:96 H264/90000
a=fmtp:96 level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f
a=candidate:1 1 udp 2130706431 192.0.2.10 54321 typ host

### Replace the publication with a fresh offer (same cane reconnecting): a
### second POST immediately supersedes the first; viewers do not renegotiate.
POST http://localhost:8080/api/v1/firmware/devices/{{deviceId}}/camera/publications
Authorization: Bearer {{deviceToken}}
Content-Type: application/sdp
Accept: application/sdp

v=0
o=- 2 1 IN IP4 127.0.0.1
s=-
t=0 0
a=group:BUNDLE 0
m=video 9 UDP/TLS/RTP/SAVPF 96
c=IN IP4 0.0.0.0
a=rtcp-mux
a=ice-ufrag:canefragtwo
a=ice-pwd:canepanioncanepwdexample02
a=fingerprint:sha-256 11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00
a=setup:actpass
a=mid:0
a=sendonly
a=rtpmap:96 H264/90000
a=fmtp:96 level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f
a=candidate:1 1 udp 2130706431 192.0.2.11 54322 typ host

### Reject a publish attempt without a device token
POST http://localhost:8080/api/v1/firmware/devices/{{deviceId}}/camera/publications
Content-Type: application/sdp

v=0
o=- 1 1 IN IP4 127.0.0.1
s=-
t=0 0

### Reject a publish attempt with the wrong Content-Type (415)
POST http://localhost:8080/api/v1/firmware/devices/{{deviceId}}/camera/publications
Authorization: Bearer {{deviceToken}}
Content-Type: application/json

{"sdp": "not how WHIP works"}

### PATCH a publication is always rejected (405, Allow: DELETE)
PATCH http://localhost:8080/api/v1/firmware/devices/{{deviceId}}/camera/publications/{{publicationId}}
Authorization: Bearer {{deviceToken}}
Content-Type: application/sdp

### Stop publishing (idempotent; repeat calls also return 204)
DELETE http://localhost:8080/api/v1/firmware/devices/{{deviceId}}/camera/publications/{{publicationId}}
Authorization: Bearer {{deviceToken}}

### Create a viewer (WHEP): succeeds even before the cane has published
POST http://localhost:8080/api/v1/devices/{{deviceId}}/camera/viewers
Authorization: Bearer {{userToken}}
Content-Type: application/sdp
Accept: application/sdp

v=0
o=- 1 1 IN IP4 127.0.0.1
s=-
t=0 0
a=group:BUNDLE 0
m=video 9 UDP/TLS/RTP/SAVPF 96
c=IN IP4 0.0.0.0
a=rtcp-mux
a=ice-ufrag:viewerfrag
a=ice-pwd:canepanionviewerpwdexample1
a=fingerprint:sha-256 22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11
a=setup:actpass
a=mid:0
a=recvonly
a=rtpmap:96 H264/90000
a=fmtp:96 level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f
a=candidate:1 1 udp 2130706431 192.0.2.20 55321 typ host

### Reject a viewer request from a user who is not the owner or guardian
POST http://localhost:8080/api/v1/devices/{{deviceId}}/camera/viewers
Authorization: Bearer {{otherUserToken}}
Content-Type: application/sdp

v=0
o=- 1 1 IN IP4 127.0.0.1
s=-
t=0 0

### Read camera session state and viewer count
GET http://localhost:8080/api/v1/devices/{{deviceId}}/camera
Authorization: Bearer {{userToken}}
Accept: application/json

### PATCH a viewer is always rejected (405, Allow: DELETE)
PATCH http://localhost:8080/api/v1/devices/{{deviceId}}/camera/viewers/{{viewerId}}
Authorization: Bearer {{userToken}}
Content-Type: application/sdp

### Stop viewing (idempotent; repeat calls also return 204)
DELETE http://localhost:8080/api/v1/devices/{{deviceId}}/camera/viewers/{{viewerId}}
Authorization: Bearer {{userToken}}

### Reject deleting a viewer created by a different user (403)
DELETE http://localhost:8080/api/v1/devices/{{deviceId}}/camera/viewers/{{viewerId}}
Authorization: Bearer {{otherUserToken}}
